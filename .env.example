# 複製成 .env 後填入實際值（setup.bat 會自動複製，並產生 AUTH_SECRET）

# MongoDB 連線字串。刪除文章使用 transaction，資料庫必須是 replica set（MongoDB Atlas 預設即是）
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Auth.js 金鑰，可用 npx auth secret 產生
AUTH_SECRET=

# 「訪客一鍵體驗」使用的示範帳號；資料庫裡沒有這個帳號時，npm run setup:db 會自動建立
DEMO_EMAIL=visitor@stockmarket.com
DEMO_PASSWORD=<請設定訪客密碼>

# 自行架設正式環境（next start、Docker）時需設為 true，Auth.js 才會信任請求的網址；部署在 Vercel 或本機開發不需要
# AUTH_TRUST_HOST=true

# 設為 true 時導覽列顯示註冊連結（目前沒有註冊功能，建議維持 false）
ENABLE_REGISTER=false
